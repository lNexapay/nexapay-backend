# Servidor Express
PORT=3000

# Base de datos PostgreSQL
DATABASE_URL=

# Autenticación JWT
JWT_SECRET=

# URL del frontend permitida por CORS
FRONTEND_URL=http://localhost:5173

# Servicio de correo de bienvenida (Vercel Functions + AWS SES)
# URL completa del endpoint, por ejemplo:
# https://nexapay-email-service.vercel.app/api/send-welcome
WELCOME_EMAIL_FUNCTION_URL=

# Clave privada compartida entre Railway y Vercel
# Debe tener exactamente el mismo valor en ambos servicios
EMAIL_SERVICE_SECRET=
